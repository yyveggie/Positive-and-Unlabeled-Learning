{
  "schema_version": "1.0",
  "frozen_at": "2026-08-15",
  "information_boundary": {
    "training_observables": ["features X", "positive/unlabeled indicator s", "declared class prior or propensity information when the condition permits it"],
    "forbidden_for_model_selection": ["validation y", "test y", "test metrics"],
    "primary_selection_rule": "maximize Lee--Liu r^2/Pr_U(score>threshold) on the P/U validation split",
    "selection_implementation": [
      "experiments/src/pu_lib.py::criteria_from_scores",
      "experiments/src/pu_lib.py::lee_liu",
      "reproducibility/pu_only_selection.py"
    ],
    "oracle_columns": "crit_oraclef1 and best-threshold test metrics are diagnostic only and are never used for headline configuration selection"
  },
  "shared_tabular_protocol": {
    "datasets": ["breast", "spambase", "mushroom", "adult", "bank"],
    "data_versions": {
      "breast": "sklearn.datasets.load_breast_cancer bundled data",
      "spambase": "OpenML spambase version 1",
      "mushroom": "OpenML mushroom version 1",
      "adult": "OpenML adult version 2 after dropna",
      "bank": "OpenML bank-marketing version 1"
    },
    "max_rows": 8000,
    "subsampling": "numpy.default_rng(seed).choice without replacement when n>max_rows",
    "split": "stratified 60% train / 20% validation / 20% test; both train_test_split calls use random_state=seed",
    "normalization": "featurewise train mean and standard deviation; epsilon 1e-9",
    "training_positive_holdout": "last max(1,floor(|P_train|/5)) labeled positives; used only by Elkan--Noto",
    "validation_PU_seed": "seed+1000",
    "model_rng": "torch.manual_seed(seed)",
    "default_network": "MLP d-64-64-1 with ReLU",
    "default_batch_size": 512,
    "default_optimizer": "Adam"
  },
  "official_grids": {
    "vpu_off": {
      "grid": [
        {"lr": 0.00003, "lam": 0.03},
        {"lr": 0.00003, "lam": 0.10},
        {"lr": 0.00010, "lam": 0.03},
        {"lr": 0.00010, "lam": 0.10}
      ],
      "fixed": {"epochs": 50, "iterations_per_epoch": 30, "batch": 500, "adam_betas": [0.5, 0.99], "lr_halving_period_epochs": 20, "mix_alpha": 0.3},
      "selection": "lowest variational loss by epoch inside a run; Lee--Liu across the four configurations"
    },
    "distpu_off": {
      "grid": [
        {"warm_lr": 0.0005, "co_mixup": 5.0},
        {"warm_lr": 0.0005, "co_mixup": 2.0},
        {"warm_lr": 0.0010, "co_mixup": 5.0},
        {"warm_lr": 0.0010, "co_mixup": 2.0}
      ],
      "fixed": {"warm_epochs": 60, "pu_epochs": 60, "batch": 256, "co_mu": 0.002, "co_entropy_max": 0.004, "co_mix_entropy": 0.04, "mix_beta": 6.0, "warm_weight_decay": 0.005, "mixup_lr": 0.00005, "mixup_weight_decay": 0.001},
      "selection": "final epoch inside a run to prevent test-label leakage; Lee--Liu across the four configurations"
    },
    "holistic_off": {
      "grid": [
        {"lr": 0.001, "warm_epochs": 10},
        {"lr": 0.001, "warm_epochs": 20},
        {"lr": 0.002, "warm_epochs": 10},
        {"lr": 0.002, "warm_epochs": 20}
